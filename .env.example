# Local PostgreSQL from docker-compose.yml. Change credentials for non-local use.
DATABASE_URL=postgresql://habitflow:habitflow@localhost:5433/habitflow

# Generate a unique secret with at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set automatically by Next.js; shown for local tooling only.
NODE_ENV=development

# Production: configure these in Vercel, never in a committed file.
# DATABASE_URL must be the Neon pooled URL with sslmode=require.
# MIGRATION_DATABASE_URL is optional for a separate, direct migration connection.
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL must both be the canonical HTTPS origin.
